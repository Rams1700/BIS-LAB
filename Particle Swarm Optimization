
import numpy as np
import matplotlib.pyplot as plt


def rosenbrock(x):
    return (1 - x[0])**2 + 100 * (x[1] - x[0]**2)**2


n_particles = 40
n_dimensions = 2
max_iterations = 1000

w_max = 0.9
w_min = 0.4
c1 = 2.0
c2 = 2.0

lower_bound = -2.0
upper_bound = 2.0

rng = np.random.default_rng(42)


positions = rng.uniform(
    lower_bound, upper_bound,
    size=(n_particles, n_dimensions)
)
velocities = rng.uniform(
    -0.5, 0.5,
    size=(n_particles, n_dimensions)
)


pbest_positions = positions.copy()
pbest_values = np.array([rosenbrock(x) for x in positions])


best_idx = np.argmin(pbest_values)
gbest_position = pbest_positions[best_idx].copy()
gbest_value = pbest_values[best_idx]


history = []


for iteration in range(max_iterations):


    w = w_max - (w_max - w_min) * (
        iteration / max_iterations
    )

    r1 = rng.random((n_particles, n_dimensions))
    r2 = rng.random((n_particles, n_dimensions))

    velocities = (
        w * velocities
        + c1 * r1 * (pbest_positions - positions)
        + c2 * r2 * (gbest_position - positions)
    )


    positions = positions + velocities


    positions = np.clip(
        positions, lower_bound, upper_bound
    )

    current_values = np.array([
        rosenbrock(x) for x in positions
    ])

    improved = current_values < pbest_values
    pbest_positions[improved] = positions[improved]
    pbest_values[improved] = current_values[improved]

    best_idx = np.argmin(pbest_values)

    if pbest_values[best_idx] < gbest_value:
        gbest_value = pbest_values[best_idx]
        gbest_position = pbest_positions[best_idx].copy()

    history.append(gbest_value)

print("Optimization completed")
print("Best position:", gbest_position)
print("Minimum function value:", gbest_value)

